# Telegram Mini App
# Токен от @BotFather (/newbot или /token). В git не попадает.
TELEGRAM_BOT_TOKEN=

# Публичный HTTPS-адрес игры
TELEGRAM_PUBLIC_URL=https://tower.rokokol.art

# База deep-link: https://t.me/<bot> для Main Mini App
# или https://t.me/<bot>/<app> для именованного приложения из /newapp.
# Пусто — приложение возьмёт https://t.me/<bot> из getMe.
TELEGRAM_APP_LINK=

# Если сеть пускает не ко всем адресам Telegram, здесь можно пришпилить
# api.telegram.org к рабочему IP; имя в запросе остаётся прежним.
TELEGRAM_API_ADDRESS=
